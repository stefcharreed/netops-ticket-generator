#!/bin/sh
# Sanitize gate: block commits with non-documentation IPs/MACs (Z1/Z2), xlsx/pdf/pcap (Z3), home paths (Z4)
# and local deny terms (Z5).
# Wired up via `git config core.hooksPath scripts`.
PY=.venv/bin/python; [ -x "$PY" ] || PY=python3
git diff --cached --name-only -z --diff-filter=ACMR | PYTHONPATH=src xargs -0 "$PY" -m packetgen.sanitize || {
  echo "pre-commit: sanitize gate failed (see findings above)"; exit 1; }
